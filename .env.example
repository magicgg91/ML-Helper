# Local Next.js/Prisma development database. Docker Compose overrides this with
# file:/app/data/database.db so the database is stored in its persistent mount.
DATABASE_URL="file:./dev.db"

# Public origin used by NextAuth callbacks and cookies.
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# SMTP connection used by the /contact form. All five values are required for
# sending; there is no SMTP URL variable in the application.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
CONTACT_EMAIL=""

# Docker Compose image. Use :dev for pre-production or :latest for the stable image.
ML_HELPER_IMAGE="ghcr.io/magicgg91/ml-helper:dev"

# Runtime variables read by the application but supplied by the platform
# rather than set by hand — listed here only so this file is a complete
# inventory of what the app reads.
#   NODE_ENV  set by `next dev` / `next build` / `next start`; the code only
#             ever tests it against "production" (src/proxy.ts, src/lib/prisma.ts).
#   PORT      read by docker-healthcheck.mjs, defaulting to 3000. The container
#             sets it; Next itself also honours it.
