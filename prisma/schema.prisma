generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guide {
  id          String    @id @default(uuid())
  slug        String    @unique
  category    Json
  status      String    @default("draft")
  active      Boolean   @default(true)
  title       Json
  content     Json
  excerpt     Json
  coverImage  String?   @map("cover_image")
  author      String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at")

  // Bloc 93/F5: every public read filters on exactly this pair and orders by
  // publishedAt — the guides list, the home page, the public layout (so: on
  // every public request), and the sitemap. Slug lookups are already served
  // by @unique above. Guides are written only from the admin, so the write
  // cost of the index is negligible next to the read frequency.
  @@index([status, active, publishedAt])
  @@map("guides")
}

model Calculator {
  id              String           @id @default(uuid())
  slug            String           @unique
  category        String
  description     Json
  active          Boolean          @default(false)
  inputs          Json
  outputs         Json
  tips            Json
  formulas        Formula[]
  referenceTables ReferenceTable[]

  @@map("calculators")
}

model Formula {
  id            String     @id @default(uuid())
  calculatorId  String     @map("calculator_id")
  key           String
  formulaParams Json       @map("formula_params")
  calculator    Calculator @relation(fields: [calculatorId], references: [id], onDelete: Cascade)

  @@unique([calculatorId, key])
  @@map("formulas")
}

model ReferenceTable {
  id           String      @id @default(uuid())
  key          String      @unique
  columns      Json
  rows         Json
  calculatorId String?     @map("calculator_id")
  calculator   Calculator? @relation(fields: [calculatorId], references: [id], onDelete: SetNull)

  @@map("reference_tables")
}

model User {
  id                   String          @id @default(uuid())
  username             String          @unique
  passwordHash         String          @map("password_hash")
  role                 String
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now()) @map("created_at")
  lastLoginAt          DateTime?       @map("last_login_at")
  totpSecretEncrypted  String?         @map("totp_secret_encrypted")
  totpEnabled          Boolean         @default(false) @map("totp_enabled")
  logs                 AuditLog[]
  staticContentUpdates StaticContent[]

  @@map("users")
}

model LoginThrottle {
  identifierHash String    @id @map("identifier_hash")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("login_throttles")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  actorRole  String   @map("actor_role")
  message    String   @default("")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  diff       Json?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("audit_logs")
}

model StaticContent {
  id        String   @id @default(uuid())
  key       String   @unique
  content   Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by")
  updater   User     @relation(fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("static_content")
}

// Bloc 90: per-locale public visibility. One row per locale that has been
// toggled; a locale with no row defaults to active. The 5 translation JSON
// files stay static in the repo — this only governs whether a language shows
// in the public selector (never the admin editorial locales, which keep all
// 5). EN/FR are always active and are enforced in code, never stored inactive.
model LocaleSetting {
  locale    String   @id
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("locale_settings")
}
